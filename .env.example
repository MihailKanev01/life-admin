# Web -> backend proxy
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8080/api/v1

# Backend
SPRING_PROFILES_ACTIVE=local
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/life_admin
SPRING_DATASOURCE_USERNAME=life_admin
SPRING_DATASOURCE_PASSWORD=life_admin
APP_BASE_URL=http://localhost:3000

# Private S3-compatible document storage (local MinIO defaults)
LIFE_ADMIN_S3_ENDPOINT=http://localhost:9000
LIFE_ADMIN_S3_REGION=eu-central-1
LIFE_ADMIN_S3_BUCKET=life-admin-documents
LIFE_ADMIN_S3_ACCESS_KEY=life_admin_minio
LIFE_ADMIN_S3_SECRET_KEY=life_admin_minio_dev_password
LIFE_ADMIN_S3_PATH_STYLE_ACCESS=true

# Never commit production secrets; use managed secrets and a private EU-region bucket.


# Transactional email through the Resend HTTPS API (password reset and reminders).
# Set these in your environment / Render dashboard; never commit a real API key.
RESEND_API_KEY=
MAIL_FROM=noreply@example.com
# For production APP_BASE_URL must be the public HTTPS web-app origin.
# MAIL_FROM must be verified with the email provider.
# LIFE_ADMIN_NOTIFICATIONS_FIXED_DELAY_MS=60000
